# Copy to .env and fill in. Never commit .env (CLAUDE.md section 2).
# Every variable is validated by packages/schema/env.ts; a missing required one fails startup.
# "Needed by" follows the Environments table in CLAUDE.md section 9.

# Postgres (Neon). Needed by: web (read), workers. Leave unset for `pnpm db:*` to use the embedded
# PGlite database in packages/db/.pglite (local development only; ADR-004).
DATABASE_URL=

# Meilisearch on Fly.io. Web needs host + search key; workers need host + master key.
MEILI_HOST=
MEILI_MASTER_KEY=
MEILI_SEARCH_KEY=

# Cloudflare R2 for the data pack (spec 01). Needed by: workers (import job), pipeline (publish,
# Windows PC only). Not yet provisioned.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The media store on Vercel Blob (ADR-034). Needed by scripts/media/publish.ts on the owner's machine
# only, from .env.local: `vercel env pull .env.local` writes BLOB_STORE_ID and a short-lived
# VERCEL_OIDC_TOKEN (the read-write token is sensitive on the project and is not pulled). Never the
# site. In CI the News workflow's cover step reads BLOB_READ_WRITE_TOKEN from a repository secret
# of that name, to add new Comm-Links' covers to the live manifest and nothing else (ADR-048).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# The media store's public address, https://<store>.public.blob.vercel-storage.com. Not a secret.
# The site puts it in front of every /media/ path and, when no media is built locally, fetches
# manifest.json from it at build (ADR-034); on Vercel it is the one media variable the site reads.
CDN_BASE_URL=

# Spectrum dev-post source. feed | poll | off. Defaults to off when unset.
# feed needs SPECTRUM_FEED_URL; poll needs SPECTRUM_SESSION_COOKIE. Needed by: workers.
SPECTRUM_MODE=off
SPECTRUM_FEED_URL=
SPECTRUM_SESSION_COOKIE=

# Error tracking. Optional everywhere.
SENTRY_DSN=

# Windows PC only (pipeline). Example: C:\Program Files\Roberts Space Industries\StarCitizen
SC_INSTALL_ROOT=
STARBREAKER_BIN=
