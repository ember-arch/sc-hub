# secrets and local config
.env
.env.*
!.env.example

# legal evidence stays out of git (keep a copy outside the repo too)
docs/legal/evidence/*
!docs/legal/evidence/.gitkeep

# pipeline output and raw game data never enter the repo
pipeline/out/
pipeline/reports/*.md
!pipeline/reports/.gitkeep

# title icons copied from the Star Citizen Wiki's uploads (CIG's art, ADR-017): local only, never
# committed; only their README and sources.json are. Web copies go to apps/web/public/media/.
fixtures/titles-media/*
!fixtures/titles-media/README.md
!fixtures/titles-media/sources.json
apps/web/public/media/

# fankit downloads (large; licensed separately)
fixtures/fankit/

# images copied from RSI's public ship matrix (ADR-009): local only, never committed
fixtures/rsi-media/*
!fixtures/rsi-media/README.md
!fixtures/rsi-media/sources.json
!fixtures/rsi-media/cover-sources.json

# the wiki's galleries of RSI's art per ship (ADR-024): local only, never committed
fixtures/galleries/*
!fixtures/galleries/README.md
!fixtures/galleries/sources.json
!fixtures/galleries/samples/

# RSI's holoviewer models (ADR-015, ADR-025): local only, never committed
fixtures/holo/*
!fixtures/holo/README.md
!fixtures/holo/sources.json
!fixtures/holo/samples/

# web copies built by scripts/media/prepare.ts from the two folders above (ADR-009)
apps/web/public/media/

# embedded local database for pnpm db:* when DATABASE_URL is unset
packages/db/.pglite/

# toolchain
node_modules/
.pnpm-store/
dist/
.next/
.turbo/
coverage/
*.tsbuildinfo
next-env.d.ts
playwright-report/
test-results/
.lighthouseci/

# os
.DS_Store
Thumbs.db

# generated at build by apps/web/scripts/licenses.ts
apps/web/generated/

# Claude desktop app tool config (preview launcher); not part of the project
.claude/

# showcase ships' art, videos and 3D models (ADR-010): local only, never committed
fixtures/showcase/

# local design-review helpers (screenshots, overflow checks, a local Playwright config); never committed
apps/web/*.local.*

# the Vercel CLI writes the project link here (ADR-033)
.vercel/

.env*
