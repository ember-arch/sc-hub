    "content_blocks": [
      {
        "id": 1,
        "type": "text",
        "data": {
          "blocks": [
            {
              "key": "a8uvf",
              "text": "Long ago, the Vara vanished into the silent depths of the Hades system, never to return, leaving only whispers and dread in its wake. Each year, we honor the departed with spirit cakes and iced wine, flickering candles, spectral costumes, and chilling tales of what lurks beyond the jump point.",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "6vq2k",
              "text": "",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "1nekg",
              "text": "Day of the Vara 2956 is upon us! Get into the spirit by carving or painting a pumpkin inspired by Frankenstein, Vampire, or Werewolf, with bonus points for adding a touch of Star Citizen, for a chance to earn some eerie rewards. Brave the return of Kill Collector in Arena Commander, and discover the haunting history behind this mysterious holiday. With new paints also making their appearance, there's plenty to sink your teeth into this season. Just remember, in the darkness of the 'verse, some things are better left undisturbed...",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [
                {
                  "offset": 0,
                  "length": 32,
                  "style": "BOLD"
                }
              ],
              "entityRanges": [],
              "data": []
            }
          ],
          "entityMap": []
        }
      },
