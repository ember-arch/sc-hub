      {
        "id": "mvibvxj7-dn4unv8b7w0",
        "type": "text",
        "data": {
          "blocks": [
            {
              "key": "cbhrt",
              "text": "Enjoy everything Day of the Vara has to offer:",
              "type": "header-one",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "d5fb9",
              "text": "Day of the Vara 2956 - Visit the official event page to discover this year's festivities, including a new contest, the return of a favorite Arena Commander mode, and eerie new paints available from October 21 through November 9.",
              "type": "unordered-list-item",
              "depth": 0,
              "inlineStyleRanges": [
                {
                  "offset": 0,
                  "length": 22,
                  "style": "BOLD"
                }
              ],
              "entityRanges": [
                {
                  "offset": 0,
                  "length": 20,
                  "key": 0
                }
              ],
              "data": []
            },
            {
              "key": "hm33",
              "text": "Pumpkin Decorating Contest - Carve or paint a pumpkin inspired by Frankenstein, Vampire, or Werewolf, and show off your creativity! Bonus points for adding Star Citizen-inspired details. Every qualifying entry earns \"The Hill Horror\" helmet, while winners will receive even more frightening rewards inspired by these classic monsters.",
              "type": "unordered-list-item",
              "depth": 0,
              "inlineStyleRanges": [
                {
                  "offset": 0,
                  "length": 29,
                  "style": "BOLD"
                }
              ],
              "entityRanges": [
                {
                  "offset": 0,
                  "length": 26,
                  "key": 1
                }
              ],
              "data": []
            },
            {
              "key": "8j7n8",
              "text": "Arena Commander - Check out the returning Arena Commander mode, Kill Collector, and jump into some scary, spooky skeleton action! Play two rounds to earn a Vanduul mask, which will be distributed after the event ends.",
              "type": "unordered-list-item",
              "depth": 0,
              "inlineStyleRanges": [
                {
                  "offset": 0,
                  "length": 18,
                  "style": "BOLD"
                }
              ],
              "entityRanges": [
                {
                  "offset": 0,
                  "length": 15,
                  "key": 2
                }
              ],
              "data": []
            },
            {
              "key": "2pflh",
              "text": "Day of the Vara - Discover the history and lore behind this chilling holiday on Galactapedia.",
              "type": "unordered-list-item",
              "depth": 0,
              "inlineStyleRanges": [
                {
                  "offset": 0,
                  "length": 18,
                  "style": "BOLD"
                }
              ],
              "entityRanges": [
                {
                  "offset": 0,
                  "length": 15,
                  "key": 3
                }
              ],
              "data": []
            },
            {
              "key": "9litt",
              "text": "Gather your courage, pilots, and see you in the ‘verse, where the lost wait in the dark…",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            }
          ],
