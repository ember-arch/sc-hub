            {
              "key": "osgi",
              "text": "They are fantastic ships. But the comand modules only take a few good hits to destroy. Is there any plans for it to share the armor of the host ship? ",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "6mabc",
              "text": "Im by no means a good tester, I miss alot of things. ",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "ercqa",
              "text": "",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            },
            {
              "key": "cl4e3",
              "text": "Just seems like a rather nasty weak spot if it gets focused.",
              "type": "unstyled",
              "depth": 0,
              "inlineStyleRanges": [],
              "entityRanges": [],
              "data": []
            }
          ],
          "entityMap": []
        }
      }
    ],
