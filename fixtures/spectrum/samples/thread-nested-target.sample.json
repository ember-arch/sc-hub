                              "blocks": [
                                {
                                  "key": "ct3ba",
                                  "text": "I mean that at the moment of release, this is the setup we are happy with.",
                                  "type": "unstyled",
                                  "depth": 0,
                                  "inlineStyleRanges": [],
                                  "entityRanges": [],
                                  "data": []
                                },
                                {
                                  "key": "dbdt7",
                                  "text": "As a wise, famous man involved in Star Citizen said multiple times: \"The only constant in game dev is change!\"",
                                  "type": "unstyled",
                                  "depth": 0,
                                  "inlineStyleRanges": [],
                                  "entityRanges": [],
                                  "data": []
                                },
                                {
                                  "key": "9ignk",
                                  "text": "",
                                  "type": "unstyled",
                                  "depth": 0,
                                  "inlineStyleRanges": [],
                                  "entityRanges": [],
                                  "data": []
                                },
                                {
                                  "key": "dhuf6",
                                  "text": "So if, after feedback or later game iteration, we think it should not be the case anymore, we might change it.",
                                  "type": "unstyled",
                                  "depth": 0,
                                  "inlineStyleRanges": [],
                                  "entityRanges": [],
                                  "data": []
                                },
                                {
                                  "key": "ds5en",
                                  "text": "As simple as that :slightly_smiling_face:",
