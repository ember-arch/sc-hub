{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter web start",
      "startServerReadyPattern": "Ready",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/ships",
        "http://localhost:3000/ships/gladius",
        "http://localhost:3000/ships/polaris",
        "http://localhost:3000/compare?ships=gladius,polaris",
        "http://localhost:3000/news",
        "http://localhost:3000/titles",
        "http://localhost:3000/funding"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
