{
  "name": "sc-hub",
  "version": "0.0.0",
  "private": true,
  "description": "SC Hub (working title): a non-commercial fan reference for Star Citizen. Monorepo root.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter web test:e2e",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm --filter schema build && tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter schema build && pnpm --filter db migrate",
    "db:seed": "pnpm --filter schema build && pnpm --filter db seed",
    "pipeline:detect": "node scripts/not-implemented.mjs pipeline:detect",
    "pipeline:extract": "node scripts/not-implemented.mjs pipeline:extract",
    "pipeline:normalize": "node scripts/not-implemented.mjs pipeline:normalize",
    "pipeline:models": "node scripts/not-implemented.mjs pipeline:models",
    "pipeline:publish": "node scripts/not-implemented.mjs pipeline:publish",
    "pipeline:all": "node scripts/not-implemented.mjs pipeline:all",
    "workers:import": "node scripts/not-implemented.mjs workers:import",
    "workers:poll-news": "pnpm --filter poll-news poll",
    "workers:poll-spectrum": "pnpm --filter poll-spectrum poll",
    "workers:link": "node scripts/not-implemented.mjs workers:link"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "0.8.3",
    "globals": "^17.14.0",
    "meshoptimizer": "0.18.1",
    "prettier": "^3.9.10",
    "schema": "workspace:*",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "zod": "4.6.7"
  }
}
