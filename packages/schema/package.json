{
  "name": "schema",
  "version": "0.0.0",
  "private": true,
  "description": "The pipeline-to-web data contract: Zod types for every entity, the enumerations, environment validation, and the JSON Schema export.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "default": "./dist/pack.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx build/emit-json-schema.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
