{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "components/**/*.tsx",
    "components/**/*.ts",
    "stories/**/*.tsx",
    "stories/**/*.ts",
    "build/**/*.ts",
    "__tests__/**/*.ts"
  ]
}
